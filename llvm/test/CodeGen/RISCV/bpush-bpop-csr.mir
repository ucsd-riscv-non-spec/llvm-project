# RUN: llc -mtriple=riscv64 -run-pass=prologepilog -o - %s \
# RUN:   | FileCheck --implicit-check-not='<badreg>' %s
--- |
  define void @uses_b25() { ret void }
  define void @uses_b24_caller_saved() { ret void }
...
---
name: uses_b25
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10
    dead $b25 = BMOVS_I $x10, 0
    $x10 = ADDI $x10, 1
    PseudoRET implicit $x10
...
# CHECK: $x2 = frame-setup ADDI $x2, -48
# CHECK: frame-setup BPUSH killed $b25, $x2, 0
# CHECK: dead $b25 = BMOVS_I $x10, 0
# CHECK: $b25 = frame-destroy BPOP $x2, 0
# CHECK: $x2 = frame-destroy ADDI $x2, 48
# The B-registers assigned after this pass must not reuse the restored one.
# CHECK: PseudoRET implicit $x10, implicit $b25
---
name: uses_b24_caller_saved
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10
    dead $b24 = BMOVS_I $x10, 0
    PseudoRET implicit $x10
...
# CHECK-LABEL: name: uses_b24_caller_saved
# CHECK-NOT: BPUSH
# CHECK: dead $b24 = BMOVS_I
# CHECK-NOT: BPOP
