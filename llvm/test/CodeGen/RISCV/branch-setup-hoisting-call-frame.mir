# RUN: llc -mtriple=riscv64 -run-pass=prologepilog -o - %s | FileCheck %s

--- |
  declare void @callee()
  define void @call_before_loop_branch() { ret void }
...
---
name: call_before_loop_branch
tracksRegLiveness: true
frameInfo:
  hasCalls: true
body: |
  bb.0:
    successors: %bb.1
    PseudoBR %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    PseudoCALL target-flags(riscv-call) @callee, csr_ilp32_lp64, implicit-def $x1, implicit-def $x2
    PseudoBRNE $x0, $x0, %bb.1

  bb.2:
    PseudoRET
...

# The conditional branch's setup is created after frame lowering and can be
# hoisted over the call, so reserve a saved B-register for it.
# CHECK: frame-setup BPUSH killed $b25
