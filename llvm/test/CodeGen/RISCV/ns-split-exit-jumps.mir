# RUN: llc -mtriple=riscv64 -run-pass=riscv-expand-pseudo %s -o - | FileCheck %s
# RUN: llc -mtriple=riscv64 -run-pass=riscv-expand-pseudo \
# RUN:   -riscv-ns-disable-split-exit-jumps %s -o - \
# RUN:   | FileCheck %s --check-prefix=OFF

# A block ending in a conditional branch and a jump expands to a PseudoPBC,
# then the jump's BMOVS_J/BMOVT_J and PseudoPBU. The setup and the jump move
# to a block of their own right after it, which the conditional falls through
# to, so that they stay on the path that takes the jump.

---
name:            split
tracksRegLiveness: true
body:             |
  ; The fall-through edge keeps its probability and goes to the new block,
  ; which always jumps; what is live into the jump's target is live into it.
  ; CHECK-LABEL: name: split
  ; CHECK:       bb.0:
  ; CHECK-NEXT:    successors: %bb.2(0x7c000000), %bb.[[J:[0-9]+]](0x04000000)
  ; CHECK:         [[C:%[0-9]+]]:pbr = BMOVC_BNE
  ; CHECK-NEXT:    PseudoPBC [[C]], %bb.2
  ; CHECK-NOT:   {{BMOV|Pseudo|ADDI}}
  ; CHECK:       bb.[[J]]:
  ; CHECK-NEXT:    successors: %bb.1(0x80000000)
  ; CHECK-NEXT:    liveins: $x12
  ; CHECK-NOT:   {{BMOV|Pseudo|ADDI}}
  ; CHECK:         [[U:%[0-9]+]]:pbr = BMOVS_J <mcsymbol {{.*}}>
  ; CHECK-NEXT:    [[U]]:pbr = BMOVT_J [[U]], %bb.1
  ; CHECK-NEXT:    PseudoPBU [[U]], %bb.1
  ; CHECK-NOT:   {{BMOV|Pseudo|ADDI}}
  ; CHECK:       bb.1:
  ; OFF-LABEL:   name: split
  ; OFF:         bb.0:
  ; OFF-NEXT:      successors: %bb.2(0x7c000000), %bb.1(0x04000000)
  ; OFF:           PseudoPBC
  ; OFF-NEXT:      BMOVS_J
  ; OFF-NEXT:      BMOVT_J
  ; OFF-NEXT:      PseudoPBU
  ; OFF-NOT:   {{BMOV|Pseudo|ADDI}}
  ; OFF:         bb.1:
  bb.0:
    successors: %bb.2(0x7c000000), %bb.1(0x04000000)
    liveins: $x10, $x11, $x12

    PseudoBRNE $x10, $x11, %bb.2
    PseudoBR %bb.1

  bb.1:
    liveins: $x12
    $x10 = ADDI $x12, 1
    PseudoRET implicit $x10

  bb.2:
    liveins: $x10
    PseudoRET implicit $x10
...
---
name:            same_target
tracksRegLiveness: true
body:             |
  ; Both edges go to one block, so they share one successor entry, which
  ; cannot be given to a new block alone: left as it is.
  ; CHECK-LABEL: name: same_target
  ; CHECK:         PseudoPBC {{%[0-9]+}}, %bb.1
  ; CHECK-NEXT:    BMOVS_J
  ; CHECK-NEXT:    BMOVT_J
  ; CHECK-NEXT:    PseudoPBU {{%[0-9]+}}, %bb.1
  ; CHECK-NOT:   {{BMOV|Pseudo|ADDI}}
  ; CHECK:       bb.1:
  bb.0:
    successors: %bb.1
    liveins: $x10, $x11

    PseudoBRNE $x10, $x11, %bb.1
    PseudoBR %bb.1

  bb.1:
    liveins: $x10
    PseudoRET implicit $x10
...
---
name:            queue
tracksRegLiveness: true
body:             |
  ; A queue's branch followed by a jump is split the same way.
  ; CHECK-LABEL: name: queue
  ; CHECK:       bb.0:
  ; CHECK-NEXT:    successors: %bb.2(0x40000000), %bb.[[J:[0-9]+]](0x40000000)
  ; CHECK:         PseudoPBC {{%[0-9]+}}, %bb.2
  ; CHECK-NOT:   {{BMOV|Pseudo|ADDI}}
  ; CHECK:       bb.[[J]]:
  ; CHECK-NEXT:    successors: %bb.1(0x80000000)
  ; CHECK-NOT:   {{BMOV|Pseudo|ADDI}}
  ; CHECK:         BMOVS_J
  ; CHECK-NEXT:    BMOVT_J {{%[0-9]+}}, %bb.1
  ; CHECK-NEXT:    PseudoPBU {{%[0-9]+}}, %bb.1
  bb.0:
    successors: %bb.2(0x40000000), %bb.1(0x40000000)
    liveins: $x10, $x11

    PseudoNSQInit 3
    PseudoNSQPush 3, $x10, $x11, 2
    PseudoNSQBR 3, 1, %bb.2
    PseudoBR %bb.1

  bb.1:
    PseudoRET

  bb.2:
    PseudoRET
...
---
name:            fallthrough_only
tracksRegLiveness: true
body:             |
  ; No jump after the conditional branch: nothing to move.
  ; CHECK-LABEL: name: fallthrough_only
  ; CHECK:         PseudoPBC {{%[0-9]+}}, %bb.2
  ; CHECK-NOT:   {{BMOV|Pseudo|ADDI}}
  ; CHECK:       bb.1:
  ; CHECK-NOT:   PseudoPBU
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $x10, $x11

    PseudoBRNE $x10, $x11, %bb.2

  bb.1:
    PseudoRET

  bb.2:
    PseudoRET
...
