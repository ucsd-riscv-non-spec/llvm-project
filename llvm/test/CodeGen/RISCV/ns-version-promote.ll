; CHECK-NEXT:    [[NSVP_CHANGED:%.*]] = icmp ne i32 [[NSVP_SLOT_1]], [[NSVP_INIT]]
; CHECK-NEXT:    br i1 [[NSVP_CHANGED]], label [[TMP0:%.*]], label [[TMP1:%.*]]
; CHECK:       0:
; CHECK-NEXT:    store i32 [[NSVP_SLOT_1]], ptr [[P]], align 4
; CHECK-NEXT:    br label [[TMP1]]
; CHECK:       1:
; CHECK-NEXT:    br label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %loop.ph, label %exit

loop.ph:
  br label %loop

loop:
  %i = phi i32 [ 0, %loop.ph ], [ %i.next, %latch ]
  %ai.addr = getelementptr inbounds i32, ptr %a, i32 %i
  %ai = load i32, ptr %ai.addr, align 4
  %pv = load i32, ptr %p, align 4
  %gt = icmp sgt i32 %ai, %pv
  br i1 %gt, label %then, label %latch

then:
  store i32 %ai, ptr %p, align 4
  br label %latch

latch:
  %inc = add i32 %ai, 1
  store i32 %inc, ptr %ai.addr, align 4
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit.loopexit, label %loop

exit.loopexit:
  br label %exit

exit:
  ret void
}
